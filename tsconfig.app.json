{
  "compilerOptions": {
    "target": "ES2020",
    "useUnknownInModuleScope": true,
    "lib": ["ES2020", "DOM", "ES2020.Symbol.WellKnownSymbols"],
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "index.html"],
  "references": []
}